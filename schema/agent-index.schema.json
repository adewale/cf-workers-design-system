{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CF Workers Design System Agent Index",
  "type": "object",
  "required": ["name", "generated_at", "entries"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "site_url": {
      "type": ["string", "null"]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "title", "kind", "summary", "keywords"],
        "properties": {
          "path": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "summary": { "type": "string" },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
