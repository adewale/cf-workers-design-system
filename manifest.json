{
  "name": "CF Workers Design System",
  "slug": "cf-workers-design",
  "version": "0.1.0",
  "description": "Agent-first static website for Cloudflare Workers-style design tokens, docs, and reusable skill files.",
  "derived_from": {
    "name": "CF Workers Design",
    "url": "https://cf-workers-design.nireka-96.workers.dev/"
  },
  "skill_installation": {
    "base_url": "https://cf-workers-design-system.adewale-883.workers.dev",
    "entrypoint": "https://cf-workers-design-system.adewale-883.workers.dev/skill.md",
    "reference_files": [
      "https://cf-workers-design-system.adewale-883.workers.dev/skill/design-tokens.md",
      "https://cf-workers-design-system.adewale-883.workers.dev/skill/components.md",
      "https://cf-workers-design-system.adewale-883.workers.dev/skill/prompting-guide.md",
      "https://cf-workers-design-system.adewale-883.workers.dev/skill/product-pages.md"
    ],
    "local_install_examples": {
      "claude_code": "TARGET_DIR=\"$HOME/.claude/skills/cf-workers-design\"",
      "opencode": "TARGET_DIR=\"$HOME/.config/opencode/skills/cf-workers-design\"",
      "codex": "TARGET_DIR=\"$HOME/.codex/skills/cf-workers-design\""
    }
  },
  "priority": "agent-first",
  "preferred_entrypoints": [
    "/manifest.json",
    "/llms.txt",
    "/skill.md",
    "/tokens.json",
    "/agent-index.json",
    "/examples.json"
  ],
  "consumption_order": [
    "Fetch /manifest.json",
    "Read /skill.md for design rules and routing",
    "Read /tokens.json for machine-friendly token values",
    "Fetch only the task-specific docs or skill references needed"
  ],
  "core_rules": [
    "Use warm cream surfaces instead of pure white.",
    "Use warm brown text instead of pure black.",
    "Use Cloudflare orange (#FF4801) as the primary accent.",
    "Buttons should be pill-shaped.",
    "Cards and bordered wrappers should use corner-bracket details.",
    "Prefer dashed borders, subtle fills, and restrained motion over loud effects."
  ],
  "resources": [
    {
      "path": "/design.md",
      "canonical_path": "/DESIGN.md",
      "kind": "design-tokens",
      "format": "markdown",
      "recommended_for": ["agents", "tools with design.md support", "humans"]
    },
    {
      "path": "/tokens.json",
      "canonical_path": "/tokens/tokens.json",
      "kind": "design-tokens",
      "format": "json",
      "recommended_for": ["agents", "tooling", "design token ingestion"]
    },
    {
      "path": "/tokens.css",
      "canonical_path": "/tokens/tokens.css",
      "kind": "design-tokens",
      "format": "css",
      "recommended_for": ["frontend implementation"]
    },
    {
      "path": "/tokens/tailwind.preset.cjs",
      "kind": "design-tokens",
      "format": "commonjs",
      "recommended_for": ["tailwind"]
    },
    {
      "path": "/skill.md",
      "canonical_path": "/skills/cf-workers-design/SKILL.md",
      "kind": "skill",
      "format": "markdown",
      "recommended_for": ["agents"]
    },
    {
      "path": "/agent-index.json",
      "kind": "search-index",
      "format": "json",
      "recommended_for": ["agents", "resource discovery"]
    },
    {
      "path": "/examples.json",
      "kind": "examples",
      "format": "json",
      "recommended_for": ["agents", "task routing"]
    },
    {
